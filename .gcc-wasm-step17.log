# early copy is necessary so that the gcc -B options find
# the right startup files when linking shared libgcc.
/bin/sh ../../../gcc-17-20260809/libgcc/../mkinstalldirs ../.././gcc
parts="";					\
for file in $parts; do					\
  rm -f ../.././gcc/$file;		\
  /usr/bin/install -c -m 644 $file ../.././gcc/;	\
  case $file in 					\
    *.a)						\
      /c/Users/Dhire/source/repos/DhirenTheHeadlights/GSEngine/msys64/mingw64/bin/llvm-ranlib.exe  ../.././gcc/$file ;;	\
  esac;							\
done
