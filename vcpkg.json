{
  "name": "gsengine",
  "version-string": "0.1.0",
  "dependencies": [
    "glfw3",
    "libpng",
    "libjpeg-turbo",
    "miniaudio",
    "shader-slang",
    "concurrentqueue",
    {
      "name": "freetype",
      "default-features": false
    },
    {
      "name": "msdfgen",
      "default-features": false,
      "features": [ "extensions" ]
    }
  ],
  "features": {
    "aftermath": {
      "description": "NVIDIA Nsight Aftermath GPU crash dump support. Requires NSIGHT_AFTERMATH_SDK env var pointing at an extracted Aftermath SDK.",
      "dependencies": [ "nsight-aftermath" ]
    }
  }
}
