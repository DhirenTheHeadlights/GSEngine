{
  "C_Cpp.intelliSenseEngine": "disabled",
  "editor.inlayHints.enabled": "off",
  "files.associations": {
    "*.cppm": "cpp",
    "*.ixx": "cpp"
  },
  "cmake.debugConfig": {
    "environment": [
      {
        "name": "VK_LOADER_LAYERS_DISABLE",
        "value": "~implicit~"
      },
      {
        "name": "VK_LAYER_PATH",
        "value": "${env:VULKAN_SDK}\\Bin"
      },
      {
        "name": "PATH",
        "value": "${env:VULKAN_SDK}\\Bin;${env:PATH}"
      }
    ]
  }
}