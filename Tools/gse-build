#!/bin/sh
set -eu

target=game
run=0
tree=
profile=
config=
project=
timeout=1800
wait=30
# Claude Code exports the session id to every tool shell, so this survives any invocation
# shape - wrapper scripts, xargs, PowerShell, subprocess - that the hook's text splice
# cannot see through. --agent is still honoured for a caller that wants to override it.
agent=${CLAUDE_CODE_SESSION_ID:-}
probe=0

usage() {
	cat <<'EOF'
gse-build - ask the running GSE editor to build, the same way its own build buttons do.

usage: Tools/gse-build [--game|--editor] [--run] [--profile NAME] [--config NAME] [--tree NAME] [--timeout SECONDS] [--wait SECONDS]

  --game             build the game target (default)
  --editor           rebuild the editor; the editor relaunches itself on success
  --run              launch a play session after a successful game build
  --profile NAME     build with a named build profile from the editor's build row;
                     this picks the build configuration and the play session shape.
                     Omit it to build the editor's own configuration with a single
                     attached client, independent of what the editor has selected.
  --config NAME      build with a named configurePreset from CMakePresets.json, without
                     needing a build profile row for it. Each configuration gets its own
                     build tree, so the first build of one compiles everything. Ignored
                     for --editor, which always rebuilds in the configuration it runs.
                     --profile wins if both are given.
  --tree NAME        build in a named worktree instead of the one you are in
  --project DIR      address the editor that has this project open; defaults to the
                     nearest directory above you that holds a .gseproj file. When
                     several editors share one engine tree, only the one with this
                     project open answers.
  --timeout SECONDS  give up waiting after this long (default 1800)
  --wait SECONDS     how long to hold the line before deferring (default 30)
  --agent ID         claim errors for this agent session (injected automatically)
  --probe            print the agent id this call received and exit without building;
                     use it to check that the build-guard hook is splicing --agent in

exit codes:
  0  build succeeded
  1  build failed and at least one error is yours
  2  bad usage, or the editor did not answer
  3  deferred - another chat is still working; your request stays queued
  4  build failed but none of the errors are yours

The request is addressed to whichever editor owns the directory you run this from, so
several editors open on different projects never steal each other's builds. A game
build defaults to the worktree you are standing in; --editor always rebuilds the
running editor. If no editor has this project open, nothing picks the request up.

The editor queues requests rather than refusing them, and one build answers every
request for the same target, profile and configuration, so several agents asking at once cost one
compile.

If another chat is still working, this does NOT block you. After --wait seconds it
returns 3 and your request keeps its place in the queue. Do not sit and retry: end
your turn with Tools/gse-hibernate --then "<what to do next>" and you will be woken
when the build lands, or go do unrelated work and re-run this later to re-attach.

Errors are split by who edited the file. Only act on the ones reported as yours;
files another chat is working on are theirs to fix, even when they break your build.
Exit 4 means nothing in the failure is yours - do not start fixing it.

This is the only sanctioned way to build. Do not invoke cmake, ninja, or a compiler
directly - the editor owns the build directory, the module cache, and the process
handles, and a build started outside it corrupts them.
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--game) target=game ;;
		--editor) target=editor ;;
		--run) run=1 ;;
		--profile)
			shift
			profile=${1:-}
			;;
		--config)
			shift
			config=${1:-}
			;;
		--tree)
			shift
			tree=${1:-}
			;;
		--project)
			shift
			project=${1:-}
			;;
		--timeout)
			shift
			timeout=${1:-1800}
			;;
		--wait)
			shift
			wait=${1:-30}
			;;
		--agent)
			shift
			agent=${1:-}
			;;
		--probe) probe=1 ;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			echo "gse-build: unknown option '$1'" >&2
			usage >&2
			exit 2
			;;
	esac
	shift
done

if [ "$probe" = 1 ]; then
	if [ -n "$agent" ]; then
		if [ "$agent" = "${CLAUDE_CODE_SESSION_ID:-}" ]; then
			source="from CLAUDE_CODE_SESSION_ID in the environment"
		else
			source="from --agent"
		fi
		echo "gse-build: agent $agent ($source) - builds and hibernates will be attributed to you."
		exit 0
	fi
	echo "gse-build: no agent id reached this call: CLAUDE_CODE_SESSION_ID is unset in this shell and the" >&2
	echo "gse-build: build-guard PreToolUse hook did not splice --agent in. Tell the user." >&2
	exit 2
fi

if [ -z "$agent" ]; then
	echo "gse-build: warning - no --agent argument, normally spliced in by the build-guard PreToolUse hook." >&2
	echo "gse-build: without it the editor cannot tell that YOU are the requester, so your own turn counts as" >&2
	echo "gse-build: a blocker and you will wait on yourself. Compile errors will also come back unowned." >&2
	echo "gse-build: check with 'Tools/gse-build --probe' (an echo of the command does not exercise the hook)." >&2
	echo "gse-build: If it reports no agent id, the hooks are not registered for this directory and the" >&2
	echo "gse-build: direct-build guard is off as well." >&2
fi

if [ -z "$project" ]; then
	dir=$(pwd)
	while [ -n "$dir" ]; do
		for manifest in "$dir"/*.gseproj; do
			if [ -e "$manifest" ]; then
				project=$dir
				break 2
			fi
		done
		parent=${dir%/*}
		if [ "$parent" = "$dir" ]; then
			break
		fi
		dir=$parent
	done
fi
if [ -n "$project" ]; then
	project=$(cd "$project" && (pwd -W 2>/dev/null || pwd))
fi

state_root=${GSE_STATE_DIR:-${LOCALAPPDATA:-$HOME/AppData/Local}/GSE}
inbox="$state_root/cache/agent-build"
id="$$-$(date +%s)"
request="$inbox/requests/$id.txt"
result="$inbox/results/$id.txt"

mkdir -p "$inbox/requests" "$inbox/results"
rm -f "$result"

{
	echo "id $id"
	echo "agent $agent"
	echo "target $target"
	echo "run $run"
	echo "tree $tree"
	echo "profile $profile"
	echo "config $config"
	echo "cwd $(pwd -W 2>/dev/null || pwd)"
	echo "project $project"
} > "$inbox/requests/$id.partial"
mv "$inbox/requests/$id.partial" "$request"

waited=0
picked_up=0
announced=
while [ "$waited" -lt "$timeout" ]; do
	if [ ! -e "$request" ] && [ "$picked_up" -eq 0 ]; then
		picked_up=1
		echo "gse-build: editor queued request $id ($target)" >&2
	fi

	body=$(cat "$result" 2>/dev/null || true)
	if [ -n "$body" ]; then
		status=$(printf '%s\n' "$body" | sed -n '2s/^status //p')

		if [ "$status" = "waiting" ]; then
			reason=$(printf '%s\n' "$body" | tail -n +4)
			if [ "$reason" != "$announced" ]; then
				announced=$reason
				echo "gse-build: $reason" >&2
			fi
			if [ "$waited" -ge "$wait" ]; then
				rm -f "$result"
				echo "gse-build: deferring - your request keeps its place in the queue and builds when the tree is free." >&2
				echo "gse-build: you are NOT blocked and nothing of yours is broken. End your turn with Tools/gse-hibernate --then \"<what to do next>\" to be woken with the result, or do unrelated work and re-run this later to re-attach." >&2
				exit 3
			fi
		else
			printf '%s\n' "$body" | tail -n +4
			owned=$(printf '%s\n' "$body" | sed -n '3s/^owned //p')
			rm -f "$result"
			case "$status" in
				ok)
					exit 0
					;;
				failed)
					if [ "${owned:-1}" -gt 0 ]; then
						echo "gse-build: build failed" >&2
						exit 1
					fi
					echo "gse-build: the build failed, but none of the errors are attributed to you. Read the split above before acting: errors owned by another chat are theirs to fix, and unattributed ones are most likely another editor instance mid-refactor." >&2
					exit 4
					;;
				*)
					echo "gse-build: the editor could not run this build ($status)" >&2
					exit 2
					;;
			esac
		fi
	fi

	if [ "$picked_up" -eq 0 ] && [ "$waited" -ge 10 ]; then
		rm -f "$request"
		echo "gse-build: no editor picked up the request within 10s - start the GSE editor and try again" >&2
		exit 2
	fi

	sleep 1
	waited=$((waited + 1))
done

rm -f "$request" "$result"

echo "gse-build: timed out after ${timeout}s waiting for the editor to finish" >&2
exit 2
