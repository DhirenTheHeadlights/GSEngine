+/* Implemetation of TARGET_ASM_INIT_SECTIONS.  */
+void
+wasm_asm_init_sections ()
+{
+  text_section = get_unnamed_section (SECTION_CODE, [](const char *){}, "T");
+  data_section = get_unnamed_section (SECTION_WRITE, [](const char *){}, "D");
