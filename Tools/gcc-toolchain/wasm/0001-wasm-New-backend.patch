+
+/* Implemetation of ASM_DECLARE_OBJECT_NAME
+   and TARGET_ASM_DECLARE_CONSTANT_NAME.  */
+void
+wasm_assemble_data_begin (FILE *stream, tree decl, const char *name,
+			  HOST_WIDE_INT size, bool pub)
+{
+  if (!name)
+    name = IDENTIFIER_POINTER (DECL_ASSEMBLER_NAME (decl));
+  if (!size)
+    size = tree_to_uhwi (DECL_SIZE_UNIT (decl));
+  output_indent (stream);
+
+  HOST_WIDE_INT align_real = align ? align : 1;
+
+  /* We gathered the alignment.  Time to reset it so that a new one can be
+   * specified.  */
+  align = 0;
+  fprintf (stream, "(data (@sym (align " HOST_WIDE_INT_PRINT_DEC "))"
+		   " (i32.const 0) (@sym $", align_real);
+  assemble_name (stream, name);
+  if (decl)
+    {
+      assemble_binding (stream, decl);
+    }
+  else
+    {
+      if (!pub)
+	fprintf (stream, " local");
+    }
+  assemble_visibility (stream, decl);
+  assemble_sym_name (stream, name);
+  fprintf (stream, " (size %ld)", size);
+  fprintf (stream, ")");
+}
