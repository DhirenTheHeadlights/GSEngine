+wasm_specify_align (HOST_WIDE_INT new_align)
+{
+  // gcc_assert (!align);
+  align = new_align;
+}
+
+/* Implemetation of ASM_OUTPUT_ALIGNED_DECL_COMMON
+   and ASM_OUTPUT_ALIGNED_DECL_LOCAL.  */
+void
+wasm_assemble_data_zeros (FILE *stream, tree decl, const char *name,
+			  HOST_WIDE_INT size, HOST_WIDE_INT decl_align,
+			  bool pub)
+{
+  wasm_specify_align (decl_align);
+  wasm_assemble_data_begin (stream, decl, name, size, pub);
+  wasm_assemble_skip (stream, size);
+  decl_end (stream);
+}
