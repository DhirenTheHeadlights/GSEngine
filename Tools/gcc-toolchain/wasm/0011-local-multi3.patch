--- a/libgcc/config/wasm/multi3.c
+++ b/libgcc/config/wasm/multi3.c
@@ -0,0 +1,105 @@
+/* 128-bit multiply for WebAssembly, for compatibility with clang-built objects.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
