+bool has_binding_decoration (const_tree decl, bool pub)
+{
+  if (!decl)
+    return !pub;
+  if (DECL_WEAK (decl) || !TREE_PUBLIC (decl))
+    return true;
+  if (DECL_VISIBILITY (decl) == VISIBILITY_HIDDEN)
+    return true;
+  return TREE_CODE (decl) == FUNCTION_DECL && DECL_STATIC_CONSTRUCTOR (decl);
+}
+
+/* Emit the binding, visibility and init-priority decorations of a symbol as a
+   sibling annotation, rather than inside its (@sym ...).
+
+   rwat, the assembler ASM_SPEC names, parses exactly `(@sym)` and
+   `(@sym (name "..."))`; anything else inside the annotation makes the whole
+   module fail to assemble, which rules out every translation unit holding an
+   internal-linkage or weak function.  An annotation it does not know it skips,
+   so moving the decorations out keeps them in the text for an assembler that
+   grows binding support, instead of dropping them on the floor.  */
+void assemble_gcc_binding (FILE *stream, const_tree decl, bool pub = true)
+{
+  if (!has_binding_decoration (decl, pub))
+    return;
+  fprintf (stream, " (@gcc.binding");
+  if (!decl)
+    fprintf (stream, " local");
+  else
+    {
+      if (TREE_CODE (decl) == FUNCTION_DECL)
+	assemble_init_prio (stream, decl);
+      assemble_binding (stream, decl);
+      assemble_visibility (stream, decl);
+    }
+  fprintf (stream, ")");
+}
+
 void
