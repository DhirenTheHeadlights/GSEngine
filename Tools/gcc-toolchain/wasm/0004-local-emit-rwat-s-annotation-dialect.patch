-  assemble_visibility (stream, decl);
   assemble_sym_name (stream, name);
-  fprintf (stream, ")\n");
+  fprintf (stream, ")");
+  assemble_gcc_binding (stream, decl);
+  fprintf (stream, "\n");
 }
 
