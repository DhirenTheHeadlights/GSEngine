+/* Whether DECL is one of the `__atomic_compare_exchange_N' builtins, whose
+   decl does not describe the library function it is called through.
+
+   The builtin takes six parameters and the library function takes five: GCC
+   drops `weak' on the way out, because libatomic's ABI never had it.  Both
+   places that do it say so and then rebuild the CALL_EXPR keeping the original
+   CALL_EXPR_FN -- builtins.cc's BUILT_IN_ATOMIC_COMPARE_EXCHANGE_* case under
+   `the weak parameter must be dropped to match the expected parameter list',
+   and expand_ifn_atomic_compare_exchange_into_call -- so the decl reached from
+   the call still carries the six-parameter prototype.  Every other target may
+   ignore that, nothing there comparing a call against its callee's parameter
+   list; here the import is emitted from the decl's type and the assembler does
+   compare, so the prototype as written rejects the call that upstream
+   deliberately emitted.  `src/c++20/tzdb.cc' is the first thing to reach it.  */
+bool
+drops_weak_param_p (const_tree decl)
+{
+  if (!DECL_P (decl) || !fndecl_built_in_p (decl, BUILT_IN_NORMAL))
+    return false;
+  switch (DECL_FUNCTION_CODE (decl))
+    {
+    case BUILT_IN_ATOMIC_COMPARE_EXCHANGE_1:
+    case BUILT_IN_ATOMIC_COMPARE_EXCHANGE_2:
+    case BUILT_IN_ATOMIC_COMPARE_EXCHANGE_4:
+    case BUILT_IN_ATOMIC_COMPARE_EXCHANGE_8:
+    case BUILT_IN_ATOMIC_COMPARE_EXCHANGE_16:
+      return true;
+    default:
+      return false;
+    }
+}
+
+/* The type an import should be described by, which is the decl's own except
+   where the decl is one the middle end calls with a shorter argument list.
+   Returning a type rather than a signature is what keeps signature_of the only
+   place a signature is derived from a type.  */
+const_tree
+imported_type_of (const_tree decl)
+{
+  const_tree type = DECL_P (decl) ? TREE_TYPE (decl) : decl;
+  if (!drops_weak_param_p (decl) || !FUNC_OR_METHOD_TYPE_P (type))
+    return type;
+
+  auto_vec<tree> params;
+  tree param;
+  function_args_iterator it;
+  FOREACH_FUNCTION_ARGS (type, param, it)
+    if (!VOID_TYPE_P (param))
+      params.safe_push (param);
+
+  /* Refused rather than trimmed blind.  The index is only meaningful against
+     the prototype upstream documents, so a prototype of another shape is a
+     change that has to be read and not a parameter that can be guessed at --
+     and gcc_assert says nothing in a release build, which is the one this is
+     built as.  */
+  if (params.length () != 6)
+    {
+      sorry ("%qD is expected to take 6 parameters, not %u", decl,
+	     params.length ());
+      return type;
+    }
+  params.ordered_remove (3);
+  return build_function_type_array (TREE_TYPE (type), params.length (),
+				    params.address ());
+}
