+/* Implemetation of ASM_OUTPUT_DEF_FROM_DECLS.  An alias is a second name for a
+   symbol, which the assembler spells as an assignment -- no code and no data,
+   so nothing to place and no section of its own.  TARGET is an identifier
+   rather than a decl because an alias may name a target this unit has no decl
+   for.
+
+   The binding directives are emitted here because this target's
+   TARGET_ASM_GLOBALIZE_LABEL and TARGET_ASM_ASSEMBLE_VISIBILITY are no-ops, so
+   the globalize_decl that varasm runs ahead of this hook writes nothing.
+
+   A function alias also needs its signature in scope, for the same reason a
+   definition does: a `call' naming it is rejected unless the signature is
+   already there, and one declared afterwards is rejected too.  So it goes
+   through declare_func into the module header, derived by signature_of, which
+   keeps every signature in this unit coming from one place.  `alias' in
+   Tools/wasm_dialect_probe.py is the measurement that the assembler takes
+   this at all, for a function and for a data symbol.  */
+void
+wasm_output_def_from_decls (FILE *stream, tree alias, tree target)
+{
+  const char *name = IDENTIFIER_POINTER (DECL_ASSEMBLER_NAME (alias));
+  assemble_linkage (stream, alias, name, true);
+  if (TREE_CODE (alias) == FUNCTION_DECL)
+    {
+      fprintf (stream, "\t.type\t");
+      assemble_name (stream, name);
+      fprintf (stream, ",@function\n");
+      declare_func (name, signature_of (TREE_TYPE (alias)).c_str ());
+    }
+  fprintf (stream, "\t.set\t");
+  assemble_name (stream, name);
+  fprintf (stream, ", ");
+  assemble_name (stream, IDENTIFIER_POINTER (target));
+  fprintf (stream, "\n");
+}
