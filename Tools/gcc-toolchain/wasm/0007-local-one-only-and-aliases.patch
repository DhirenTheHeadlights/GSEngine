+/* Open NAME's own section, PREFIX being `.text.' or `.data.'.  GROUP is the
+   comdat group the symbol belongs to, or null for a symbol that is not
+   one-only: a group is what makes the linker keep one copy of a decl the front
+   end emitted into several units -- an inline function, a vtable, a template's
+   static member -- rather than leave two weak definitions and take whichever it
+   met first.  It is GCC's own group identifier and not NAME because several
+   decls can share one, which is how a vtable and its typeinfo are kept or
+   discarded together.
+
+   Every symbol gets a section of its own, the ones that are not one-only
+   included, because switching back to plain `.text' does NOT end a group: a
+   function emitted after a one-only one joins it, and the linker then discards
+   that function along with the duplicate copy of the group.  The symptom is
+   `undefined symbol' naming a symbol the object plainly defines, which reads
+   like a relocation bug and is not one.  `comdat' in
+   Tools/wasm_dialect_probe.py is the measurement.  */
+void
+emit_symbol_section (FILE *stream, const char *prefix, const char *name,
+		     tree group)
+{
+  fprintf (stream, "\t.section\t%s", prefix);
+  assemble_name (stream, name);
+  if (!group)
+    {
+      fprintf (stream, ",\"\",@\n");
+      return;
+    }
+  fprintf (stream, ",\"G\",@,%s,comdat\n", IDENTIFIER_POINTER (group));
+}
+
+/* The comdat group DECL belongs to, or null.  DECL is null on the constant-pool
+   path, which has no decl to ask and nothing to deduplicate.  */
+tree
+group_of (const_tree decl)
+{
+  if (!decl || !VAR_OR_FUNCTION_DECL_P (decl) || !DECL_ONE_ONLY (decl))
+    return NULL_TREE;
+  return DECL_COMDAT_GROUP (decl);
+}
