+   Tools/build_gcc_wasm.py's ASM_FEATURES has to carry the same list, because that
+   script assembles every probe by hand rather than through this spec, and
+   check_asm_features refuses to run when the two disagree.  */
+#define ASM_SPEC "-triple=wasm32-unknown-unknown -mattr=+atomics,+bulk-memory " 		 "-filetype=obj %{v:--show-encoding} %{Wa,*:%*}"
 
